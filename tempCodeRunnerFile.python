n = int(input("Enter n: "))
r = int(input("Enter r: "))

f1 = 1
f2 = 1
f3 = 1

for i in range(1, n + 1):
    f1 = f1 * i

for i in range(1, r + 1):
    f2 = f2 * i

for i in range(1, (n - r) + 1):
    f3 = f3 * i

permutation = f1 / f3
combination = f1 / (f2 * f3)

print("Permutation =", int(permutation))
print("Combination =", int(combination))